type carbonhv_host_app, domain, coredomain;
app_domain(carbonhv_host_app)

type carbonhv_host_runtime_service, service_manager_type;
system_internal_prop(carbonhv_config_prop)

# Only the dedicated host integration process may publish the privileged runtime Binder.
add_service(carbonhv_host_app, carbonhv_host_runtime_service)
binder_use(carbonhv_host_app)

# The authenticated host integration is the only client of carbonhvd's broker Binder.
allow carbonhv_host_app carbonhv_broker_service:service_manager find;
binder_call(carbonhv_host_app, carbonhvd)

# Keep framework service discovery narrow. Locked-boot startup uses ActivityManager and
# UI signing-certificate authentication uses PackageManager.
allow carbonhv_host_app activity_service:service_manager find;
allow carbonhv_host_app package_service:service_manager find;

# The UI signing digest is supplied by the controlled host product as a read-only property.
get_prop(carbonhv_host_app, carbonhv_config_prop)

# CarbonHV's platform host integration owns AVF for the graphical VM it launches.
virtualizationservice_use(carbonhv_host_app)
is_flag_enabled(RELEASE_AVF_SUPPORT_CUSTOM_VM_WITH_PARAVIRTUALIZED_DEVICES, `
    allow carbonhv_host_app virtualization_service:service_manager find;
    allow carbonhv_host_app virtualizationservice:binder call;
    allow carbonhv_host_app crosvm_domain:binder { call transfer };
')

# The framework opens broker-validated image paths before handing descriptors to crosvm.
allow carbonhv_host_app system_data_file:dir search;
allow carbonhv_host_app carbonhv_data_file:dir r_dir_perms;
allow carbonhv_host_app carbonhv_data_file:file rw_file_perms;
