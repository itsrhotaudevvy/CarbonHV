-kernel
@GUEST@/kernel
-initrd
@GUEST@/initrd
-append
printk.devkmsg=on audit=1 panic=-1 8250.nr_uarts=1 binder.impl=rust cma=0 firmware_class.path=/vendor/etc/ loop.max_part=7 init=/init bootconfig console=ttyAMA0 earlycon=pl011,mmio32,0x9000000
