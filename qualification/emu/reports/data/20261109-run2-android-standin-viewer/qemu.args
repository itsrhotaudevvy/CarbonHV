-name
guest=carbonhv-android-standin,debug-threads=on
-machine
virt,gic-version=3,highmem=on,usb=off
-accel
tcg,thread=multi,tb-size=512
-cpu
max,pauth-impdef=on
-smp
6
-m
3072
-nodefaults
-no-user-config
-no-reboot
-rtc
base=utc
-msg
timestamp=on
-qmp
tcp:127.0.0.1:5561,server=on,wait=off
-serial
file:@GUEST@/serial.log
-device
virtio-gpu-pci,id=gpu0,addr=02.0,xres=720,yres=1280
-device
virtio-serial-pci-non-transitional,max_ports=31,id=virtio-serial
-chardev
file,id=hvc0,path=@GUEST@/hvc0-kernel.log
-device
virtconsole,bus=virtio-serial.0,chardev=hvc0
-chardev
socket,id=hvc1,host=127.0.0.1,port=5560,server=on,wait=off,logfile=@GUEST@/console.log
-device
virtconsole,bus=virtio-serial.0,chardev=hvc1
-chardev
file,id=hvc2,path=@GUEST@/logcat.log
