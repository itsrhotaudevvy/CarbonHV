--- a/ui/android.c
+++ b/ui/android.c
@@ -0,0 +1,497 @@
+/*
+ * CarbonHV: `-display android` — present the guest screen as AHardwareBuffers.
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ *
+ * Phase 4 of the emulated engine (docs/superpowers/plans/2026-11-08-qemu-emulated-engine.md).
+ * QEMU sends each frame to the `:vm` service as an AHardwareBuffer over a SOCK_SEQPACKET
+ * socketpair, without copying it a second time on the way to the app's surface.
+ *
+ * This file is the readback (v1) mode: the scanout pixman surface is converted into one of a
+ * ring of three CPU-writable, GPU-samplable buffers. The zero-copy gfxstream scanout is Phase 6
+ * and replaces `android_capture()`'s conversion, not the transport around it.
+ *
+ * Wire format: ui/android-proto.h (matched by crates/carbon-emu/src/frame_proto.rs).
+ */
+
+#include "qemu/osdep.h"
+#include "qapi/error.h"
+#include "qapi/qapi-types-ui.h"
+#include "qemu/error-report.h"
+#include "qemu/main-loop.h"
+#include "qemu/module.h"
+#include "qom/object.h"
+#include "ui/console.h"
+#include "ui/android-proto.h"
+
+#include <android/hardware_buffer.h>
+#include <sys/socket.h>
+
+/* The protocol header copies these values so it can be compiled on the build host. Keep them
+ * honest: a silent AHardwareBuffer renumbering would corrupt every frame. */
+G_STATIC_ASSERT(ANDROID_AHB_FORMAT_R8G8B8A8_UNORM ==
+                AHARDWAREBUFFER_FORMAT_R8G8B8A8_UNORM);
+G_STATIC_ASSERT(ANDROID_AHB_USAGE_CPU_READ_RARELY ==
+                AHARDWAREBUFFER_USAGE_CPU_READ_RARELY);
+G_STATIC_ASSERT(ANDROID_AHB_USAGE_CPU_WRITE_OFTEN ==
+                AHARDWAREBUFFER_USAGE_CPU_WRITE_OFTEN);
+G_STATIC_ASSERT(ANDROID_AHB_USAGE_GPU_SAMPLED_IMAGE ==
+                AHARDWAREBUFFER_USAGE_GPU_SAMPLED_IMAGE);
+
+/* The AHB is described as R8G8B8A8 bytes, which pixman spells by bit position rather than by byte
+ * order: a8b8g8r8 is bits a|b|g|r from the top, which on little-endian memory is exactly
+ * R,G,B,A. PIXMAN_r8g8b8a8 is the same word seen from the other end: it writes A,B,G,R, which
+ * the first phone run showed as a black console painted solid red.
+ *
+ * This must be `#if`, not `#ifdef`: QEMU's qemu/compiler.h always *defines* HOST_BIG_ENDIAN,
+ * as `(__BYTE_ORDER__ == __ORDER_BIG_ENDIAN__)`, so it is defined even when it is 0 and an
+ * `#ifdef` picks the big-endian branch on every little-endian host, silently. */
+#if HOST_BIG_ENDIAN
+#define ANDROID_DST_PIXMAN_FORMAT PIXMAN_r8g8b8a8
+#else
+#define ANDROID_DST_PIXMAN_FORMAT PIXMAN_a8b8g8r8
+#endif
+
+typedef struct AndroidDisplay {
+    DisplayChangeListener dcl;
+    int frame_fd;
+    bool listening;
+    /* The surface the console currently shows. Owned by the console; only touched from the
+     * callbacks below and from dpy_refresh, all of which run on the main loop thread. */
+    DisplaySurface *surface;
+    AndroidFrameRing ring;
+    AHardwareBuffer *buffer[ANDROID_RING_SLOTS];
+    /* Per-slot damage: the union of guest updates since this slot was last captured. A slot
+     * reused after N frames must absorb all of them, not just the last refresh tick's. `full`
+     * forces a whole-buffer copy (fresh allocation, mode change, or surface switch). */
+    AndroidDamage damage[ANDROID_RING_SLOTS];
+    bool full[ANDROID_RING_SLOTS];
+    uint32_t width;
+    uint32_t height;
+    uint32_t format;
+    bool mode_valid;
+    bool dirty;
+    bool broken;
+    uint64_t frames_sent;
+    uint64_t frames_dropped;
+    uint64_t releases;
+    uint64_t releases_unknown;
+    uint64_t resizes_ignored;
+    uint64_t lock_failures;
+} AndroidDisplay;
+
+static AndroidDisplay *android_display;
+
+static bool android_send_bytes(int fd, const uint8_t *bytes, size_t len)
+{
+    ssize_t sent;
+
+    do {
+        sent = send(fd, bytes, len, MSG_NOSIGNAL);
+    } while (sent < 0 && errno == EINTR);
+
+    return sent == (ssize_t)len;
+}
+
+static void android_free_buffers(AndroidDisplay *ad)
+{
+    size_t i;
+
+    for (i = 0; i < ANDROID_RING_SLOTS; i++) {
+        if (ad->buffer[i]) {
+            AHardwareBuffer_release(ad->buffer[i]);
+            ad->buffer[i] = NULL;
+        }
+        android_damage_clear(&ad->damage[i]);
+        ad->full[i] = true;
+    }
+}
+
+/* Converts just `rect` of the scanout surface into `buffer`. An empty rect means the buffer
+ * already matches the surface and nothing is copied. The rect is also passed to the lock so
+ * gralloc's cache maintenance is bounded to the region actually written, not the whole buffer.
+ * The lock returns the buffer's base address regardless of the rect, so offsets are absolute. */
+static bool android_capture(AndroidDisplay *ad, AHardwareBuffer *buffer,
+                            uint32_t width, uint32_t height, const AndroidDamage *rect)
+{
+    ARect lock_rect;
+    int32_t bytes_per_pixel = 0;
+    int32_t bytes_per_stride = 0;
+    uint8_t *dst = NULL;
+    int rc;
+
+    if (android_damage_empty(rect)) {
+        return true;
+    }
+
+    lock_rect.left = (int32_t)rect->x;
+    lock_rect.top = (int32_t)rect->y;
+    lock_rect.right = (int32_t)(rect->x + rect->w);
+    lock_rect.bottom = (int32_t)(rect->y + rect->h);
+
+    rc = AHardwareBuffer_lockAndGetInfo(buffer,
+                                        AHARDWAREBUFFER_USAGE_CPU_WRITE_OFTEN,
+                                        -1, &lock_rect, (void **)&dst,
+                                        &bytes_per_pixel, &bytes_per_stride);
+    if (rc != 0) {
+        ad->lock_failures++;
+        return false;
+    }
+
+    if (surface_format(ad->surface) == ANDROID_DST_PIXMAN_FORMAT &&
+        surface_stride(ad->surface) == bytes_per_stride &&
+        bytes_per_stride == (int32_t)width * 4) {
+        /* Already the layout the reader wants: copy only the damaged rows and columns. */
+        uint32_t y;
+        const uint8_t *src = surface_data(ad->surface);
+        size_t col_off = (size_t)rect->x * 4;
+        size_t row_bytes = (size_t)rect->w * 4;
+
+        for (y = rect->y; y < rect->y + rect->h; y++) {
+            memcpy(dst + (size_t)y * bytes_per_stride + col_off,
+                   src + (size_t)y * bytes_per_stride + col_off, row_bytes);
+        }
+    } else {
+        pixman_image_t *target;
+
+        if (bytes_per_stride < (int32_t)width * 4) {
+            AHardwareBuffer_unlock(buffer, NULL);
+            ad->lock_failures++;
+            return false;
+        }
+        target = pixman_image_create_bits(ANDROID_DST_PIXMAN_FORMAT, width, height,
+                                          (uint32_t *)dst, bytes_per_stride);
+        if (!target) {
+            AHardwareBuffer_unlock(buffer, NULL);
+            ad->lock_failures++;
+            return false;
+        }
+        pixman_image_composite32(PIXMAN_OP_SRC, ad->surface->image, NULL, target,
+                                 (int)rect->x, (int)rect->y, 0, 0,
+                                 (int)rect->x, (int)rect->y,
+                                 (int)rect->w, (int)rect->h);
+        pixman_image_unref(target);
+    }
+
+    AHardwareBuffer_unlock(buffer, NULL);
+    return true;
+}
+
+static AHardwareBuffer *android_alloc_buffer(uint32_t width, uint32_t height)
+{
+    AHardwareBuffer_Desc desc = {
+        .width = width,
+        .height = height,
+        .layers = 1,
+        .format = AHARDWAREBUFFER_FORMAT_R8G8B8A8_UNORM,
+        .usage = ANDROID_FRAME_USAGE,
+    };
+    AHardwareBuffer *buffer = NULL;
+
+    if (AHardwareBuffer_allocate(&desc, &buffer) != 0) {
+        return NULL;
+    }
+    return buffer;
+}
+
+/* Announces the new geometry and restarts the ring. Send this before the frame it describes. */
+static bool android_send_mode(AndroidDisplay *ad, uint32_t width, uint32_t height)
+{
+    uint8_t message[ANDROID_PROTO_HEADER_BYTES + ANDROID_MODE_BYTES];
+    size_t len = android_proto_mode(message, width, height,
+                                    ANDROID_AHB_FORMAT_R8G8B8A8_UNORM);
+
+    android_free_buffers(ad);
+    android_ring_reset(&ad->ring);
+    ad->width = width;
+    ad->height = height;
+    ad->format = ANDROID_AHB_FORMAT_R8G8B8A8_UNORM;
+    ad->mode_valid = true;
+
+    return android_send_bytes(ad->frame_fd, message, len);
+}
+
+static void android_frame(AndroidDisplay *ad)
+{
+    uint8_t message[ANDROID_PROTO_HEADER_BYTES + ANDROID_FRAME_BYTES];
+    uint32_t index = 0;
+    uint32_t seq = 0;
+    uint32_t width, height;
+    AndroidDamage rect;
+    size_t len;
+
+    if (!ad->surface || ad->broken) {
+        return;
+    }
+
+    width = surface_width(ad->surface);
+    height = surface_height(ad->surface);
+    if (width == 0 || height == 0 || width > ANDROID_PROTO_MAX_DIMENSION ||
+        height > ANDROID_PROTO_MAX_DIMENSION) {
+        return;
+    }
+
+    if (!ad->mode_valid || width != ad->width || height != ad->height) {
+        if (!android_send_mode(ad, width, height)) {
+            ad->broken = true;
+            return;
+        }
+    }
+
+    if (!android_ring_acquire(&ad->ring, &index, &seq)) {
+        /* Three buffers are still with the app. Dropping is the contract: a vCPU must never
+         * wait for the display. */
+        ad->frames_dropped++;
+        return;
+    }
+
+    if (!ad->buffer[index]) {
+        ad->buffer[index] = android_alloc_buffer(width, height);
+        if (!ad->buffer[index]) {
+            android_ring_release(&ad->ring, seq);
+            ad->frames_dropped++;
+            return;
+        }
+        /* A new allocation has no valid pixels to preserve. */
+        ad->full[index] = true;
+    }
+
+    if (ad->full[index]) {
+        rect.x = 0;
+        rect.y = 0;
+        rect.w = width;
+        rect.h = height;
+    } else {
+        rect = ad->damage[index];
+        android_damage_clip(&rect, width, height);
+    }
+
+    if (!android_capture(ad, ad->buffer[index], width, height, &rect)) {
+        /* Keep this slot's damage: without a successful capture its contents are still stale. */
+        android_ring_release(&ad->ring, seq);
+        return;
+    }
+    android_damage_clear(&ad->damage[index]);
+    ad->full[index] = false;
+
+    len = android_proto_frame(message, seq, width, height, ad->format,
+                              ANDROID_FRAME_USAGE, false);
+    if (!android_send_bytes(ad->frame_fd, message, len) ||
+        AHardwareBuffer_sendHandleToUnixSocket(ad->buffer[index], ad->frame_fd) != 0) {
+        android_ring_release(&ad->ring, seq);
+        ad->broken = true;
+        error_report("android display: frame socket failed: %s", strerror(errno));
+        return;
+    }
+
+    ad->frames_sent++;
+}
+
+static void android_read_handler(void *opaque)
+{
+    AndroidDisplay *ad = opaque;
+    uint8_t incoming[ANDROID_PROTO_MAX_PAYLOAD];
+    ssize_t got;
+
+    for (;;) {
+        uint32_t seq, width, height, dpi;
+
+        do {
+            got = recv(ad->frame_fd, incoming, sizeof(incoming), MSG_DONTWAIT);
+        } while (got < 0 && errno == EINTR);
+
+        if (got < 0 && (errno == EAGAIN || errno == EWOULDBLOCK)) {
+            return;
+        }
+        if (got == 0) {
+            /* The app closed its end. Keep decoding nothing; the display stays up so the guest
+             * can still be shut down cleanly, but stop polling a dead socket. */
+            qemu_set_fd_handler(ad->frame_fd, NULL, NULL, NULL);
+            ad->listening = false;
+            return;
+        }
+        if (got < 0) {
+            qemu_set_fd_handler(ad->frame_fd, NULL, NULL, NULL);
+            ad->listening = false;
+            ad->broken = true;
+            return;
+        }
+
+        if (android_proto_decode_release(incoming, (size_t)got, &seq)) {
+            if (android_ring_release(&ad->ring, seq)) {
+                ad->releases++;
+            } else {
+                /* Late release for a buffer freed by a mode change, or a stale/duplicate seq. */
+                ad->releases_unknown++;
+            }
+        } else if (android_proto_decode_resize(incoming, (size_t)got, &width, &height, &dpi)) {
+            /* v1 has no guest display hotplug; the app's own surface scaling covers rotation.
+             * Recorded rather than silently ignored so a future version can act on it. */
+            ad->resizes_ignored++;
+            info_report("android display: resize request %ux%u @ %u dpi not applied (v1)",
+                        width, height, dpi);
+        } else {
+            ad->releases_unknown++;
+        }
+    }
+}
+
+static void android_refresh(DisplayChangeListener *dcl)
+{
+    AndroidDisplay *ad = android_display;
+
+    if (!ad || !ad->dirty || ad->broken) {
+        return;
+    }
+    ad->dirty = false;
+    android_frame(ad);
+}
+
+static void android_switch(DisplayChangeListener *dcl, DisplaySurface *surface)
+{
+    AndroidDisplay *ad = android_display;
+
+    if (!ad) {
+        return;
+    }
+    ad->surface = surface;
+    if (surface && (surface_width(surface) != ad->width ||
+                    surface_height(surface) != ad->height)) {
+        ad->mode_valid = false;
+    }
+    /* Every existing slot predates this surface, including slots still with the app. */
+    for (size_t i = 0; i < ANDROID_RING_SLOTS; i++) {
+        android_damage_clear(&ad->damage[i]);
+        ad->full[i] = true;
+    }
+    ad->dirty = true;
+}
+
+static void android_update(DisplayChangeListener *dcl, int x, int y, int w, int h)
+{
+    AndroidDisplay *ad = android_display;
+    size_t i;
+
+    if (!ad || ad->broken || !ad->surface || w <= 0 || h <= 0) {
+        return;
+    }
+
+    /* The same update must reach every slot: each one has been idle for a different number
+     * of refresh ticks. Clip here so callbacks cannot leave an out-of-surface lock rect. */
+    for (i = 0; i < ANDROID_RING_SLOTS; i++) {
+        AndroidDamage update = {
+            .x = (uint32_t)MAX(x, 0),
+            .y = (uint32_t)MAX(y, 0),
+            .w = (uint32_t)w,
+            .h = (uint32_t)h,
+        };
+        android_damage_clip(&update, surface_width(ad->surface),
+                            surface_height(ad->surface));
+        android_damage_union(&ad->damage[i], &ad->damage[i], &update);
+    }
+    ad->dirty = true;
+}
+
+static void android_mouse_set(DisplayChangeListener *dcl, int x, int y, bool on)
+{
+    AndroidDisplay *ad = android_display;
+    uint8_t message[ANDROID_PROTO_HEADER_BYTES + ANDROID_CURSOR_BYTES];
+    size_t len;
+
+    if (!ad || ad->broken) {
+        return;
+    }
+    len = android_proto_cursor(message, on ? (uint32_t)MAX(x, 0) : 0,
+                               on ? (uint32_t)MAX(y, 0) : 0, on);
+    if (!android_send_bytes(ad->frame_fd, message, len)) {
+        ad->broken = true;
+    }
+}
+
+static const DisplayChangeListenerOps android_ops = {
+    .dpy_name = "android",
+    .dpy_refresh = android_refresh,
+    .dpy_gfx_update = android_update,
+    .dpy_gfx_switch = android_switch,
+    .dpy_mouse_set = android_mouse_set,
+};
+
+static void android_display_init(DisplayState *ds, DisplayOptions *opts)
+{
+    AndroidDisplay *ad;
+    QemuConsole *con;
+    uint8_t hello[ANDROID_PROTO_HEADER_BYTES + ANDROID_HELLO_BYTES];
+    size_t hello_len;
+    int fd;
+
+    if (android_display) {
+        error_report("android display: only one display is supported");
+        exit(1);
+    }
+
+    fd = (int)opts->u.android.frame_fd;
+    if (fd < 0) {
+        error_report("android display: frame-fd must be a non-negative descriptor");
+        exit(1);
+    }
+
+    ad = g_new0(AndroidDisplay, 1);
+    ad->frame_fd = fd;
+    android_ring_init(&ad->ring);
+    android_display = ad;
+
+    con = qemu_console_lookup_default();
+    qemu_console_register_listener(con, &ad->dcl, &android_ops);
+
+    /* One second of frames is worthless once the guest is gone; the app learns about the end of
+     * the session from the socket closing, not from a timeout here. */
+    qemu_console_listener_set_refresh(&ad->dcl, GUI_REFRESH_INTERVAL_DEFAULT);
+
+    hello_len = android_proto_hello(hello);
+    if (!android_send_bytes(ad->frame_fd, hello, hello_len)) {
+        error_report("android display: cannot write the greeting to fd %d: %s",
+                     fd, strerror(errno));
+        exit(1);
+    }
+
+    qemu_set_fd_handler(ad->frame_fd, android_read_handler, NULL, ad);
+    ad->listening = true;
+    info_report("android display: frame socket on fd %d, %s presentation",
+                fd, "readback");
+}
+
+static void android_display_cleanup(void)
+{
+    AndroidDisplay *ad = android_display;
+
+    if (!ad) {
+        return;
+    }
+    if (ad->listening) {
+        qemu_set_fd_handler(ad->frame_fd, NULL, NULL, NULL);
+    }
+    qemu_console_unregister_listener(&ad->dcl);
+    android_free_buffers(ad);
+    info_report("android display: %" PRIu64 " frames sent, %" PRIu64 " dropped, "
+                "%" PRIu64 " released, %" PRIu64 " unknown releases, "
+                "%" PRIu64 " lock failures, %" PRIu64 " resizes ignored",
+                ad->frames_sent, ad->frames_dropped, ad->releases,
+                ad->releases_unknown, ad->lock_failures, ad->resizes_ignored);
+    /* The descriptor belongs to the parent; QEMU must not close it before it has finished
+     * writing, but nothing else is owed to the app. */
+    android_display = NULL;
+    g_free(ad);
+}
+
+static QemuDisplay qemu_display_android = {
+    .type = DISPLAY_TYPE_ANDROID,
+    .init = android_display_init,
+    .cleanup = android_display_cleanup,
+};
+
+static void register_android(void)
+{
+    qemu_display_register(&qemu_display_android);
+}
+
+type_init(register_android);
