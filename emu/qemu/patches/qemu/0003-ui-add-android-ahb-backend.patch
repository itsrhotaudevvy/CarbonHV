# QEMU: add the `-display android` backend (CarbonHV emulated engine, Phase 4).
#
# QEMU cannot hand a frame to an app on Android: the existing backends either need a desktop
# toolkit (gtk, sdl, cocoa), a socket protocol the app sandbox cannot use (vnc, dbus), or they
# render into a DRI node an app may not open (egl-headless).  This backend presents the scanout
# as an AHardwareBuffer over an inherited SOCK_SEQPACKET socketpair, which is the one frame
# transport that stays zero-copy from QEMU's GPU to the app's Surface:
#
#   - ui/android-proto.h  the wire format and the per-mode buffer ring.  Free of QEMU and
#                         Android headers on purpose, so the build host can compile it and
#                         check it against the Rust decoder (qualification/emu/frame-proto/).
#   - ui/android.c        binds a DisplayChangeListener to the default console, converts the
#                         scanout into a ring of three CPU-writable buffers (v1 readback mode;
#                         the gfxstream/DMABUF zero-copy scanout is Phase 6 and replaces only
#                         the conversion), and applies the app's RELEASE backpressure.
#   - qapi/ui.json        `-display android,frame-fd=N`, gated on CONFIG_ANDROID_DISPLAY.
#   - meson.build         CONFIG_ANDROID_DISPLAY, true only when the host system is Android.
#
# Built only for Android (host_os == 'android'), so no other target gains a code path.  Frames
# are dropped, never blocked on: a vCPU must not wait for the display.  AHardwareBuffer handles
# travel with AHardwareBuffer_sendHandleToUnixSocket; sockets are validated message by message,
# because the app side of the socket is not trusted to send well-formed datagrams.
#
# Upstream status: not submitted (Android-only requirement; CarbonHV carries it as a patch).
--- a/meson.build
+++ b/meson.build
@@ -2553,6 +2553,10 @@
 config_host_data.set('CONFIG_SPICE', spice.found())
 config_host_data.set('CONFIG_X11', x11.found())
 config_host_data.set('CONFIG_DBUS_DISPLAY', dbus_display)
+# CarbonHV: the `-display android` backend ships only in the Android build.  QEMU's
+# configure maps the NDK cross compiler to host_os 'linux', so the compiler's own define is
+# the honest test (the same one the bionic shm patch above uses).
+config_host_data.set('CONFIG_ANDROID_DISPLAY', cc.get_define('__ANDROID__') != '')
 config_host_data.set('CONFIG_CFI', get_option('cfi'))
 config_host_data.set('CONFIG_SELINUX', selinux.found())
 config_host_data.set('CONFIG_XEN_BACKEND', xen.found())
